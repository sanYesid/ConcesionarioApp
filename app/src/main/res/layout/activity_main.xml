<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Título principal -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gestión de Concesionario"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- Campo para la Placa (Clave Primaria) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Placa del vehículo:"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPlaca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:inputType="textCapCharacters" />

        <!-- Campo para la Marca -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Marca:"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etMarca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:inputType="textCapWords" />

        <!-- Campo para el Modelo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Modelo:"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etModelo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:inputType="textCapWords" />

        <!-- Campo para el Precio -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Precio ($):"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPrecio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:inputType="numberDecimal" />

        <!-- Botón para Registrar (Create) -->
        <Button
            android:id="@+id/btnRegistrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar Auto"
            android:backgroundTint="#0066FF"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <!-- Botón para Buscar/Consultar (Read) -->
        <Button
            android:id="@+id/btnConsultar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Buscar por Placa"
            android:backgroundTint="#0066FF"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <!-- Botón para Modificar (Update) -->
        <Button
            android:id="@+id/btnModificar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Modificar Auto"
            android:backgroundTint="#0066FF"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <!-- Botón para Eliminar (Delete) -->
        <Button
            android:id="@+id/btnEliminar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Eliminar Auto"
            android:backgroundTint="#0066FF"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <!-- Botón para Limpiar Campos de Texto -->
        <Button
            android:id="@+id/btnLimpiar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Limpiar Campos"
            android:backgroundTint="#0066FF"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>